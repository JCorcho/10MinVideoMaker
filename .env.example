# Non-secret launcher settings. Real local values belong in .env (ignored by Git).
# TENMIN_CIVITAI_TOKEN and TENMIN_DISCORD_WEBHOOK_URL are encrypted in
# runtime/secrets.json; never put them in this file or Git.
TENMIN_GMAIL_USERNAME="owner@gmail.com"
TENMIN_GMAIL_RECIPIENT="owner@gmail.com"
TENMIN_GMAIL_ALLOWED_SENDERS="owner@gmail.com"
TENMIN_GMAIL_AUTH_MODE="app_password"
# OAuth2 setup writes its non-secret granted-scope marker here automatically.
# TENMIN_GMAIL_OAUTH_SCOPES="https://mail.google.com/ https://www.googleapis.com/auth/drive.readonly"
TENMIN_COMFY_URL="http://127.0.0.1:8188"
TENMIN_POLL_SECONDS="300"
TENMIN_STATUS_INTERVAL_SECONDS="15"
TENMIN_T2I_TIMEOUT_SECONDS="3600"
TENMIN_I2V_TIMEOUT_SECONDS="21600"
TENMIN_MAX_STAGE_ATTEMPTS="2"
TENMIN_FFMPEG="ffmpeg"
TENMIN_FFPROBE="ffprobe"
TENMIN_LOG_LEVEL="INFO"
